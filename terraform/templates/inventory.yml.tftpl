# Generated by terraform - do not edit
---
all:
  vars:
    ansible_user: ${ssh_user}
    ansible_ssh_private_key_file: ${ssh_private_key}
    ansible_python_interpreter: /usr/bin/python3

    web_public_ip: ${web_public_ip}
    web_private_ip: ${web_private_ip}
    db_private_ip: ${db_private_ip}
    vpc_cidr: ${vpc_cidr}
    public_subnet_cidr: ${public_subnet_cidr}
    private_subnet_cidr: ${private_subnet_cidr}
    aws_region: ${aws_region}

  children:
    web:
      hosts:
        web-server:
          ansible_host: ${web_public_ip}

    db:
      hosts:
        db-server:
          ansible_host: ${db_private_ip}
          # no public IP, go through the web server
          ansible_ssh_common_args: >-
            -o ProxyCommand="ssh -W %h:%p -q -i ${ssh_private_key}
            -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
            ${ssh_user}@${web_public_ip}"
